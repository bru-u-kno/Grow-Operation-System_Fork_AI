{
  "alias": "Water Chiller Regelung",
  "description": "Schaltet den Wasserkuehler nach Kuehlbedarf (binary_sensor.chiller_kuhlbedarf, Totband um sensor.chiller_zieltemperatur_aktiv). Tag- und Nachtziel haengen am Lichtzustand, nicht an der Uhr. Mindestlaufzeit und -pause laufen gegen input_datetime.chiller_letzter_schaltvorgang statt gegen last_changed, weil eine Funksteckdose bei WLAN-Aussetzern kurz unavailable wird - beim Kompressor ist das kein Schoenheitsfehler, sondern seine Lebensdauer. Der Minutentakt holt Schaltungen nach, die an einer Sperre gescheitert sind. Automation ausschalten heisst: Regelung pausiert, die Steckdose bleibt, wie sie ist. Angelegt von Grow OS Fork AI - Herkunft: fork-ai/chiller/regelung/1.",
  "mode": "single",
  "max_exceeded": "silent",
  "variables": {
    "alter_s": "{% set ts = state_attr('input_datetime.chiller_letzter_schaltvorgang', 'timestamp') %}{{ 999999 if ts is none else (now().timestamp() - ts) }}",
    "laufzeit_frei": "{{ alter_s >= (states('input_number.chiller_mindestlaufzeit') | float(5) * 60) }}",
    "pause_frei": "{{ alter_s >= (states('input_number.chiller_mindestpause') | float(5) * 60) }}"
  },
  "triggers": [
    { "trigger": "state", "entity_id": "binary_sensor.chiller_kuhlbedarf", "to": ["on", "off"] },
    { "trigger": "time_pattern", "minutes": "/1" },
    { "trigger": "homeassistant", "event": "start" }
  ],
  "actions": [
    {
      "choose": [
        {
          "alias": "Einschalten",
          "conditions": [
            { "condition": "state", "entity_id": "binary_sensor.chiller_kuhlbedarf", "state": "on" },
            { "condition": "state", "entity_id": "[[steckdose]]", "state": "off" },
            { "condition": "template", "value_template": "{{ pause_frei }}" }
          ],
          "sequence": [
            {
              "action": "homeassistant.turn_on",
              "target": { "entity_id": "[[steckdose]]" }
            },
            {
              "action": "input_datetime.set_datetime",
              "target": { "entity_id": "input_datetime.chiller_letzter_schaltvorgang" },
              "data": { "datetime": "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}" }
            }
          ]
        },
        {
          "alias": "Ausschalten",
          "conditions": [
            { "condition": "state", "entity_id": "binary_sensor.chiller_kuhlbedarf", "state": "off" },
            { "condition": "state", "entity_id": "[[steckdose]]", "state": "on" },
            { "condition": "template", "value_template": "{{ laufzeit_frei }}" }
          ],
          "sequence": [
            {
              "action": "homeassistant.turn_off",
              "target": { "entity_id": "[[steckdose]]" }
            },
            {
              "action": "input_datetime.set_datetime",
              "target": { "entity_id": "input_datetime.chiller_letzter_schaltvorgang" },
              "data": { "datetime": "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}" }
            }
          ]
        }
      ]
    }
  ]
}
